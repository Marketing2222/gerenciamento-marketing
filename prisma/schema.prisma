datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id           String        @id @default(uuid())
  name         String
  role         String        // "DESIGNER" or "TRAFFIC_MANAGER"
  avatarUrl    String
  passwordHash String?       // opcional, hash simples para PIN/senha
  
  assignedTasks Task[]       @relation("AssignedTasks")
  createdTasks  Task[]       @relation("CreatedTasks")
  comments      Comment[]
  activityLogs  ActivityLog[]
}

model Task {
  id           String          @id @default(uuid())
  title        String
  description  String          // HTML text editor content
  priority     String          // "LOW", "MEDIUM", "HIGH", "URGENT"
  status       String          // "BACKLOG", "TODO", "IN_PROGRESS", "AWAITING_APPROVAL", "DONE"
  createdAt    DateTime        @default(now())
  dueDate      DateTime?
  
  assigneeId   String?
  assignee     User?           @relation("AssignedTasks", fields: [assigneeId], references: [id])
  
  creatorId    String?
  creator      User?           @relation("CreatedTasks", fields: [creatorId], references: [id])
  
  checklist    ChecklistItem[]
  attachments  Attachment[]
  comments     Comment[]
  activityLogs ActivityLog[]
}

model ChecklistItem {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  type      String   // "FILE" or "LINK"
  url       String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // ex: "Criou a tarefa", "Movou para Em Andamento"
  createdAt DateTime @default(now())
}
