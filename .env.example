# ===== CONFIGURAÇÃO DO FIREBASE =====
# Preencha com os valores do seu projeto Firebase (console.firebase.google.com)
# Vá em: Configurações do projeto -> Seus apps -> (crie um App Web se ainda não tiver)
# -> copie o objeto "firebaseConfig"
#
# IMPORTANTE: Estas variáveis são lidas em runtime (não no build).
# Você pode usar o prefixo NEXT_PUBLIC_ ou não — ambos funcionam.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ===== SENHA DO CRONOGRAMA DE VÍDEOS =====
# Senha para autorizar pagamento/conclusão no cronograma
# Se não definida, usa "1234" como padrão
SCHEDULE_PASSWORD=
